# rag_ingestion configuration — copy to `.env` and fill in.
# All settings use the RAG_INGEST_ prefix (pydantic-settings). `.env` is
# gitignored; this template is safe to commit. Only the Azure keys are secrets.

# --- embeddings (semantic chunker only; pdf/docx) ---------------------------
# Provider: "sentence_transformers" (fully local, default) or "azure".
RAG_INGEST_EMBEDDING_PROVIDER=sentence_transformers
RAG_INGEST_EMBEDDING_BATCH_SIZE=64

# local sentence-transformers (used when provider == sentence_transformers).
# Model is downloaded once from the HF hub then cached; set device to "cuda" if
# you have a compatible GPU.
RAG_INGEST_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_INGEST_LOCAL_EMBEDDING_DEVICE=cpu

# azure (used only when provider == azure) — the only real secrets here.
RAG_INGEST_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
RAG_INGEST_AZURE_OPENAI_API_KEY=<your-azure-openai-key>
RAG_INGEST_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- semantic chunking ------------------------------------------------------
RAG_INGEST_BREAKPOINT_THRESHOLD_TYPE=percentile
RAG_INGEST_BREAKPOINT_THRESHOLD_AMOUNT=95.0

# --- sizing -----------------------------------------------------------------
RAG_INGEST_MAX_PARENT_TOKENS=3000
RAG_INGEST_MAX_CHILD_TOKENS=800
RAG_INGEST_MIN_CHILD_TOKENS=100

# --- tabular ----------------------------------------------------------------
RAG_INGEST_ROW_BATCH_TARGET_TOKENS=400
RAG_INGEST_MAX_ROWS_PER_CHUNK=10
RAG_INGEST_MAX_ROWS_FOR_ROW_CHUNKING=5000

# --- pptx -------------------------------------------------------------------
RAG_INGEST_SLIDE_WINDOW=1

# --- parent strategy ladder (pdf; see README §5.1.1) ------------------------
RAG_INGEST_MIN_HEADINGS_FOR_STRUCTURE=2
RAG_INGEST_MIN_HEADING_PAGE_COVERAGE=0.6
RAG_INGEST_ENABLE_LLM_TOC_INFERENCE=false
RAG_INGEST_TOC_INFERENCE_DEPLOYMENT=gpt-4o-mini
RAG_INGEST_MAX_HEADING_CANDIDATES=500
RAG_INGEST_MAX_HEADING_CHARS=120

# --- quality gates ----------------------------------------------------------
RAG_INGEST_MIN_CHARS_PER_PAGE=50

# --- runtime ----------------------------------------------------------------
RAG_INGEST_MAX_WORKERS=4
RAG_INGEST_ENABLE_EMBEDDING_CACHE=true
RAG_INGEST_CACHE_DIR=.ingest_cache
